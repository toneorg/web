# Public origin (e.g. https://seudominio.com.br), used for the share preview image,
# canonical URLs and the invite link. Leave empty in local dev.
NEXT_PUBLIC_SITE_URL=

# Shown on /privacidade as the address for deletion requests.
NEXT_PUBLIC_CONTACT_EMAIL=

# The tone server (toneorg/extension), reached from this server by /api/tone. Unset = /conversas says it is not connected.
TONE_API_URL=

# The tone extension id (chrome-extension://<id>), so /conversas can tell it a local search is waiting.
# The extension must be built with TONE_WEB_ORIGIN set to this site's HTTPS origin. Unset = it checks every minute.
NEXT_PUBLIC_TONE_EXTENSION_ID=

# PostHog: product analytics, errors, session replay and logs of the BFF. Without them, analytics are off.
# With a PostHog Cloud host (us/eu.i.posthog.com) the browser goes through /ingest on this site (next.config.ts).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
