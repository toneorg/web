# Where form submissions go (JSON POST). A Google Apps Script web app works well:
# see docs/google-sheets-webhook.md. Zapier, Make or n8n webhooks work too.
# Unset in local dev = records are appended to data/submissions.jsonl.
# Required in production: without it, submissions are refused rather than
# written to a disk that may not survive a deploy.
SUBMISSIONS_WEBHOOK_URL=

# Only for a production build on a machine whose disk you trust (e.g. testing
# `npm run start` locally): set to 1 to allow the data/submissions.jsonl fallback.
SUBMISSIONS_ALLOW_DISK=

# Public origin, used for the share preview image and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://example.com

# Shown on /privacidade as the address for deletion requests.
NEXT_PUBLIC_CONTACT_EMAIL=
