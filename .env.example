# Public origin (e.g. https://seudominio.com.br), used for the share preview image,
# canonical URLs and the invite link. Leave empty in local dev.
NEXT_PUBLIC_SITE_URL=

# Shown on /privacidade as the address for deletion requests.
NEXT_PUBLIC_CONTACT_EMAIL=

# The tone server, reached from this server by /api/tone. Unset = /conversas says it is not connected.
TONE_API_URL=

# PostHog: product analytics, errors, session replay and logs of the BFF. Without them, analytics are off.
# With a PostHog Cloud host (us/eu.i.posthog.com) the browser goes through /ingest on this site (next.config.ts).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Where the two public forms go: the waiting list (/api/lista) and the pilot requests (/api/piloto).
# This server POSTs each entry as JSON ({ kind: "waitlist" | "pilot", ...fields, receivedAt }) to this URL:
# a sheet, an automation or the tone server. Unset = the forms answer that they could not send, with the contact e-mail.
LEADS_WEBHOOK_URL=

# The "recebemos seu interesse" e-mail after someone joins the waiting list (src/lib/waitlist-mail.ts).
# Resend, from a sender on a domain verified there (heytone.app). Unset = the entry is saved and no e-mail goes out.
RESEND_API_KEY=
MAIL_FROM=tone <avisos@heytone.app>
